# PostgreSQL local — usuário: postgres
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/espetinhos"

# Auth.js v5 — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="substitua-por-um-segredo-aleatorio"
AUTH_TRUST_HOST="true"

# Super admin do seed — deixe vazio no exemplo; preencha só no .env local
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Focus NFe — token vazio = emissão simulada (sem nota fiscal real)
FOCUS_NFE_TOKEN=""
FOCUS_NFE_AMBIENTE="homologacao"

# SintegraBrasil — chave gratuita em https://www.sintegrabrasil.com.br/api/painel
# Sem chave a busca de CNPJ usa BrasilAPI (sem inscrição estadual).
SINTEGRABRASIL_API_KEY=""
